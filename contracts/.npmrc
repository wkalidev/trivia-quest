# MiniPay Mini App submission requirement -- dependency supply-chain hardening.
# See: https://docs.minipay.xyz/getting-started/submit-your-miniapp.html#dependency-security
#
# Reject any npm package version published less than 7 days ago. Malicious/compromised
# releases are typically yanked within days, so this window blocks fresh supply-chain
# attacks from slipping in on a reinstall, even if the lockfile gets regenerated.
# NOTE: unit is DAYS (not minutes) and the key is `min-release-age`, not
# `minimum-release-age` -- npm silently ignores unknown config keys with just a
# CLI warning, so the old key name was a no-op. Also requires npm >=12 to take
# effect at all; npm <12 warns and ignores it either way.
min-release-age=7

# Never run postinstall/preinstall/install scripts from dependencies automatically.
ignore-scripts=true

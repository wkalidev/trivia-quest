# MiniPay Mini App submission requirement -- dependency supply-chain hardening.
# See: https://docs.minipay.xyz/getting-started/submit-your-miniapp.html#dependency-security
#
# Reject any npm package version published less than 7 days ago. Malicious/compromised
# releases are typically yanked within days, so this window blocks fresh supply-chain
# attacks from slipping in on a reinstall, even if the lockfile gets regenerated.
# NOTE: unit is DAYS (not minutes) and the key is `min-release-age`, not
# `minimum-release-age` -- npm silently ignores unknown config keys with just a
# CLI warning, so the old key name was a no-op. Also requires npm >=12 to take
# effect at all; npm <12 warns and ignores it either way.
min-release-age=7

# NOTE: unlike frontend/ and contracts/, this package intentionally does NOT set
# ignore-scripts=true. bot/package.json has its own `postinstall: patch-package`,
# which applies patches/@selfxyz+agent-sdk+0.2.1.patch -- a real functional fix to
# the Self Agent SDK's Ed25519 signing path (swaps in @noble/curves/ed25519
# because the installed @noble/ed25519 v3 needs a sync SHA-512 hash wired up
# that it doesn't have by default). Verified empirically: a fresh `npm ci` with
# ignore-scripts=true skips that postinstall and leaves Ed25519Agent.js on the
# unpatched, broken code path -- confirmed by grepping the installed file, not
# assumed. Until there's a way to allow just this one project-level postinstall
# script while still blocking dependency install scripts, this stays off here.
